{
  "name": "coding-prac",
  "version": "0.3.0",
  "description": "Chat-first local coding and algorithm practice agent.",
  "homepage": "https://pardraverse.navinresearch.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyoo-147/PardraVerse.git"
  },
  "bugs": {
    "url": "https://github.com/kyoo-147/PardraVerse/issues"
  },
  "type": "module",
  "bin": {
    "prac": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --sourcemap",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "commander": "^14.0.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
