# Provider keys are environment-only and are never written by `prac provider setup`.
# Run `prac provider setup --provider ... --base-url ... --model ...` to save non-secret settings.
# OpenAI-compatible provider (OpenAI, OpenRouter, local gateways, etc.)
PRAC_AI_PROVIDER=openai-compatible
PRAC_AI_BASE_URL=https://api.openai.com/v1
# Optional provider-specific aliases (use one key, never commit this file with a value).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
PRAC_AI_MODEL=gpt-5-mini
PRAC_AI_API_KEY=

# Or Anthropic
# PRAC_AI_PROVIDER=anthropic
# PRAC_AI_BASE_URL=https://api.anthropic.com/v1
# PRAC_AI_MODEL=claude-sonnet-4-5
# PRAC_AI_API_KEY=
